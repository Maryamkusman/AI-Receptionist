# Copy to backend/.env and fill in what you have. Everything is optional:
# without keys FullChair runs in demo mode (simulated SMS, payments and booking).

# Claude — powers the receptionist. Without it, a simple scripted demo agent answers.
ANTHROPIC_API_KEY=
FULLCHAIR_MODEL=claude-opus-5-5

# Database — SQLite by default. For Postgres: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./fullchair.db

# Twilio (SMS + voice). Without these, outbound texts are logged to the dashboard outbox.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Instagram / Meta messaging
META_VERIFY_TOKEN=fullchair-verify
META_PAGE_ACCESS_TOKEN=

# Stripe deposits. Without it, deposit links open a demo checkout page.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public URL of this API (deposit links, Twilio webhooks). Use your ngrok/Render URL in production.
PUBLIC_BASE_URL=http://localhost:8000

# Background jobs (refill + nudges) run in-process every N minutes. 0 disables.
JOBS_INTERVAL_MINUTES=15

# Where the dashboard runs (for CORS)
DASHBOARD_ORIGIN=http://localhost:3000
